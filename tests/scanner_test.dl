import support.dl
import ../src/scanner.dl

create a temporary directory
set temporary to it
expect truth (temporary succeeded)
set root to temporary's directory path

set nested to repository path from root and the string form of "BadDir/InnerDir"
create a directory tree at nested
expect truth (it succeeded)

set javascript_path to repository path from nested and the string form of "BadFile.js"
write the string form of "const value = 1;\n" to the file at javascript_path
expect truth (it succeeded)

set php_path to repository path from root and the string form of "good_file.php"
write the string form of "<?php\n" to the file at php_path
expect truth (it succeeded)

set hidden_directory to repository path from root and the string form of ".github"
create a directory at hidden_directory
expect truth (it succeeded)
set hidden_file to repository path from hidden_directory and the string form of "HiddenFile.js"
write the string form of "const hidden = true;\n" to the file at hidden_file
expect truth (it succeeded)

set third_party_directory to repository path from root and the string form of "third_party/BadVendor"
create a directory tree at third_party_directory
expect truth (it succeeded)
set third_party_file to repository path from third_party_directory and the string form of "BadFile.cpp"
write (the string form of "int vendor_value;\n") repeated 1001 times to the file at third_party_file
expect truth (it succeeded)

set distribution_directory to repository path from root and the string form of "package/dist"
create a directory tree at distribution_directory
expect truth (it succeeded)
set distribution_file to repository path from distribution_directory and the string form of "BadBundle.js"
write (the string form of "const generatedValue = true;\n") repeated 1001 times to the file at distribution_file
expect truth (it succeeded)

set large_path to repository path from root and the string form of "huge_file.cpp"
write (the string form of "int value;\n") repeated 1001 times to the file at large_path
expect truth (it succeeded)

set loaded to load conventions from "naming:\n  repository:\n    case: kebab-case\n  directory:\n    case: snake_case\n  language:\n    php:\n      file: snake_case\n    cpp:\n      file: camelCase\n    javascript:\n      file: snake_case\n"
expect truth (loaded's succeeded)
set rules to loaded's conventions

set scanned to scan repository tree at root
expect truth (scanned's succeeded)
set tree to scanned's tree
expect truth (tree includes language "cpp")
expect truth (tree includes language "javascript")
expect truth (tree includes language "php")
set entries to tree's entries
set entry_position to 0
loop while entry_position < the length of entries:
    set scanned_entry to @intrinsic("cast", the item at entry_position in entries, a repository entry)
    expect falsehood (scanned_entry's relative path contains ".github")
    expect falsehood (scanned_entry's relative path contains "third_party")
    expect falsehood (scanned_entry's relative path contains "dist")
    set entry_position to entry_position + 1

set excluded_renames to an empty list of string
set directory_rename to the next directory rename in tree using rules excluding excluded_renames
expect truth (directory_rename's found)
expect directory_rename's source relative path to equal "BadDir/InnerDir"
expect directory_rename's target relative path to equal "BadDir/inner_dir"

set file_rename to the next file rename for "javascript" in tree using rules excluding excluded_renames
expect truth (file_rename's found)
expect file_rename's source relative path to equal "BadDir/InnerDir/BadFile.js"
expect file_rename's target relative path to equal "BadDir/InnerDir/bad_file.js"

set large_files to check for source files larger than 1000 lines in tree
expect truth (large_files's succeeded)
expect the length of large_files's violations to equal 1
expect the item at 0 in large_files's violations to equal "huge_file.cpp exceeds 1000 lines"
expect the length of large_files's failures to equal 0
free source file size result large_files
free excluded_renames

free repository tree result scanned
free conventions result loaded
remove the filesystem tree at root
expect truth (it succeeded)

create a temporary directory
set literal_temporary to it
expect truth literal_temporary succeeded
set literal_root to literal_temporary's directory path
set config_path to repository path from literal_root and "vite.config.js"
write the string form of "export default {};\n" to the file at config_path
expect truth it succeeded
set test_path to repository path from literal_root and "BadBrowser.test.js"
write the string form of "export const value = 1;\n" to the file at test_path
expect truth it succeeded
set literal_rules to load conventions from "naming:\n  repository:\n    case: kebab-case\n  directory:\n    case: snake_case\n  language:\n    javascript:\n      file: snake_case\n"
expect truth literal_rules's succeeded
set literal_scan to scan repository tree at literal_root
expect truth literal_scan's succeeded
set literal_exclusions to an empty list of string
set literal_rename to the next file rename for "javascript" in literal_scan's tree using literal_rules's conventions excluding literal_exclusions
expect truth literal_rename's found
expect literal_rename's source relative path to equal "BadBrowser.test.js"
expect literal_rename's target relative path to equal "bad_browser.test.js"
append literal_rename's source relative path to literal_exclusions
set no_config_rename to the next file rename for "javascript" in literal_scan's tree using literal_rules's conventions excluding literal_exclusions
expect falsehood no_config_rename's found
free literal_exclusions
free repository tree result literal_scan
free conventions result literal_rules
remove the filesystem tree at literal_root
expect truth it succeeded

print "scanner: passed" as a line
