import support.dl
import ../src/language_server.dl

create a temporary directory
set temporary to it
expect truth (temporary succeeded)
set root to temporary's directory path

set script to "import json,os,sys\ndef read():\n h={}\n while True:\n  line=sys.stdin.buffer.readline()\n  if line==b'\\r\\n': break\n  n,v=line.decode('ascii').split(':',1);h[n.lower()]=v.strip()\n return json.loads(sys.stdin.buffer.read(int(h['content-length'])))\ndef send(m):\n p=json.dumps(m,separators=(',',':')).encode();sys.stdout.buffer.write(b'Content-Length: '+str(len(p)).encode()+b'\\r\\n\\r\\n'+p);sys.stdout.buffer.flush()\nassert os.environ['CARGO_BUILD_JOBS']=='2';init=read();assert init['params']['capabilities']['window']['workDoneProgress'] is True;send({'jsonrpc':'2.0','id':init['id'],'result':{'capabilities':{'textDocumentSync':0}}});assert read()['method']=='initialized';\nfor i in range(1100): send({'jsonrpc':'2.0','method':'window/logMessage','params':{'type':3,'message':str(i)}})\nsend({'jsonrpc':'2.0','id':91,'method':'window/workDoneProgress/create','params':{'token':'index'}});reply=read();assert reply['id']==91 and reply['result'] is None;send({'jsonrpc':'2.0','method':'$/progress','params':{'token':'index','value':{'kind':'begin','title':'Indexing workspace'}}});send({'jsonrpc':'2.0','method':'$/progress','params':{'token':'index','value':{'kind':'report','message':'halfway'}}});send({'jsonrpc':'2.0','method':'$/progress','params':{'token':'index','value':{'kind':'end','message':'done'}}});shutdown=read();assert shutdown['method']=='shutdown';send({'jsonrpc':'2.0','id':shutdown['id'],'result':None});assert read()['method']=='exit'"
set backend_arguments to an empty list of string
append the string form of "-u" to backend_arguments
append the string form of "-c" to backend_arguments
append script to backend_arguments
set backend to a language backend named "rust" using "python3" with backend_arguments waiting for "Indexing workspace"

set begun to begin language session using backend in root
expect truth begun's succeeded
set finished to finish language session begun's session
expect truth finished's succeeded

free language backend backend
remove the filesystem tree at root
expect truth it succeeded

print "language server progress: passed" as a line
