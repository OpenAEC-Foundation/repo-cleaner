import conventions.dl
import github.dl

class:
    patterns:
        [a|the|] repository check result
    members:
        succeeded as boolean
        violation as boolean
        changed as boolean
        repository name as string
        description as string
        error message as string

local function a repository check result succeeded {boolean:succeeded}, violation {boolean:violation}, changed {boolean:changed}, for {string:repository_name}, described by {string:description}, reporting {string:error}:
    replacement:
        @intrinsic(
            "construct",
            a repository check result,
            succeeded,
            violation,
            changed,
            repository_name,
            description,
            error
        )

local function the repository naming issue title:
    replacement:
        the string form of "Naming convention violations"

local function naming issue body for {string:repository_name} using {a pointer to conventions:rules}:
    execute:
        set style to the repository case in rules
        set words to the number of words in repository_name
        set text to the string form of "# Naming Convention Violations\n\nThis repository's name has the following issues:\n\n"
        set manual to words = 0 or words > 3
        if words = 0:
            set text to text + the string form of "- The name does not contain a word that can be converted\n"
        else if words > 3:
            set text to text + the string form of "- Too many segments (>3) - needs manual review\n"
        else:
            set text to text + the string form of "- Does not match "
            set text to text + the name of case style
            set text to text + the string form of "\n- Suggested: `"
            set text to text + convert repository_name to style
            set text to text + the string form of "`\n"
        if manual:
            set text to text + the string form of "\n## Action Required\n\nRename this repository manually to use no more than three segments and follow the configured case.\n"
        else:
            set text to text + the string form of "\n## Action\n\nThis can be fixed automatically with the suggested name above.\n"
        set text to text + the string form of "\n---\n*This issue was automatically generated by the convention enforcer.*\n"
        return text

function enforce the repository naming convention for {string:repository_address} named {string:repository_name} using {a pointer to conventions:rules} and {a pointer to github tools:tools}, fixing {boolean:fixing}:
    execute:
        set style to the repository case in rules
        set words to the number of words in repository_name
        set valid to words > 0 and words <= 3
        set valid to valid and repository_name follows style in rules
        if valid:
            set closed to close issue titled the repository naming issue title in repository_address using tools
            if the inverse of closed's succeeded:
                return a repository check result succeeded false, violation false, changed false, for repository_name, described by the string form of "", reporting closed's error message
            return a repository check result succeeded true, violation false, changed false, for repository_name, described by the string form of "Repository name follows its convention", reporting the string form of ""

        set body to naming issue body for repository_name using rules
        set manual to words = 0 or words > 3
        if fixing and the inverse of manual:
            set suggested to convert repository_name to style
            set renamed to rename github repository repository_address to suggested using tools
            if renamed's succeeded:
                set slash to the length of repository_address - the length of repository_name
                set owner_prefix to the substring of repository_address from 0 spanning slash bytes
                set new_address to owner_prefix + suggested
                set closed to close issue titled the repository naming issue title in new_address using tools
                if the inverse of closed's succeeded:
                    return a repository check result succeeded false, violation true, changed true, for suggested, described by (the string form of "Renamed repository to ") + suggested, reporting closed's error message
                return a repository check result succeeded true, violation true, changed true, for suggested, described by (the string form of "Renamed repository to ") + suggested, reporting the string form of ""
            set issue to ensure pinned issue titled the repository naming issue title in repository_address with body body using tools
            set error to renamed's error message
            if the inverse of issue's succeeded:
                set error to error + the string form of "; recording the naming violation failed: "
                set error to error + issue's error message
            return a repository check result succeeded false, violation true, changed false, for repository_name, described by the string form of "", reporting error

        set issue to ensure pinned issue titled the repository naming issue title in repository_address with body body using tools
        if the inverse of issue's succeeded:
            return a repository check result succeeded false, violation true, changed false, for repository_name, described by the string form of "", reporting issue's error message
        return a repository check result succeeded true, violation true, changed false, for repository_name, described by the string form of "Repository name violates its convention", reporting the string form of ""

function check the readme in {string:repository_address} using {a pointer to github tools:tools}:
    execute:
        set file to read github file "README.md" in repository_address using tools
        if the inverse of file's succeeded:
            return a repository check result succeeded false, violation false, changed false, for repository_address, described by the string form of "", reporting file's error message
        if file's found:
            return a repository check result succeeded true, violation false, changed false, for repository_address, described by the string form of "README.md exists", reporting the string form of ""
        return a repository check result succeeded true, violation true, changed false, for repository_address, described by the string form of "README.md is missing", reporting the string form of ""

function enforce the standard license {string:standard} in {string:repository_address} on {string:branch} using {a pointer to github tools:tools}, fixing {boolean:fixing}:
    execute:
        set file to read github file "LICENSE.md" in repository_address using tools
        if the inverse of file's succeeded:
            return a repository check result succeeded false, violation false, changed false, for repository_address, described by the string form of "", reporting file's error message
        set current to the string form of ""
        set sha to the string form of ""
        if file's found:
            set current to file's contents
            set sha to file's sha
        set violation to the inverse of file's found or current != standard
        if the inverse of violation:
            return a repository check result succeeded true, violation false, changed false, for repository_address, described by the string form of "LICENSE.md is current", reporting the string form of ""
        if the inverse of fixing:
            return a repository check result succeeded true, violation true, changed false, for repository_address, described by the string form of "LICENSE.md is missing or differs from the standard", reporting the string form of ""
        set message to the string form of "Apply the standard LGPL 3.0 license"
        set written to write github file "LICENSE.md" in repository_address with contents standard, message message, branch branch, and existing sha sha using tools
        if the inverse of written's succeeded:
            return a repository check result succeeded false, violation true, changed false, for repository_address, described by the string form of "", reporting written's error message
        return a repository check result succeeded true, violation true, changed true, for repository_address, described by the string form of "Updated LICENSE.md", reporting the string form of ""

function synchronize the empty repository issue in {string:repository_address} empty {boolean:empty} using {a pointer to github tools:tools}:
    execute:
        set title to the string form of "Empty repository"
        if empty:
            set body to the string form of "# Empty Repository\n\nThis repository has no commits yet. Please add initial content or consider removing it.\n\n---\n*This issue was automatically generated by the convention enforcer.*\n"
            return ensure pinned issue titled title in repository_address with body body using tools
        return close issue titled title in repository_address using tools
