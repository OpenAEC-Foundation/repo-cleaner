        )

function find issue titled {string:title} in {string:repository_name} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "issue" to arguments
        append the string form of "list" to arguments
        append the string form of "-R" to arguments
        append repository_name to arguments
        append the string form of "--state" to arguments
        append the string form of "all" to arguments
        append the string form of "--search" to arguments
        append (the string form of "\"") + title + the string form of "\" in:title" to arguments
        append the string form of "--json" to arguments
        append the string form of "number,title,state,isPinned" to arguments
        append the string form of "--limit" to arguments
        append the string form of "100" to arguments
        set completed to run github using tools with arguments
        free arguments
        if the inverse of completed's succeeded:
            return a failed github issue result reporting completed's error message

        parse completed's standard output as JSON and set parsed to it
        if parsed failed:
            free parsed
            return a failed github issue result reporting the string form of "GitHub issue list is not valid JSON"
        set root to the value of parsed
        if root is not a JSON array:
            free parsed
            return a failed github issue result reporting the string form of "GitHub issue list must be an array"
        set position to 0
        loop while position < the number of JSON items in root:
            set node to the JSON value at index position in root
            if node is not a JSON object:
                free parsed
                return a failed github issue result reporting the string form of "GitHub issue data must be an object"
            set incomplete to node lacks JSON member named "number"
            set incomplete to incomplete or node lacks JSON member named "title"
            set incomplete to incomplete or node lacks JSON member named "state"
            set incomplete to incomplete or node lacks JSON member named "isPinned"
            if incomplete:
                free parsed
                return a failed github issue result reporting the string form of "GitHub issue data is incomplete"
            set number_node to the JSON member named "number" in node
            set title_node to the JSON member named "title" in node
            set state_node to the JSON member named "state" in node
            set pinned_node to the JSON member named "isPinned" in node
            set invalid to the kind of number_node != the JSON number kind
            set invalid to invalid or the kind of title_node != the JSON text kind
            set invalid to invalid or the kind of state_node != the JSON text kind
            set invalid to invalid or the kind of pinned_node != the JSON boolean kind
            if invalid:
                free parsed
                return a failed github issue result reporting the string form of "GitHub issue data is invalid"
            if the text of title_node = title:
                set number_value to the number of number_node
                if number_value < 1.0 or number_value > 2147483647.0:
                    free parsed
                    return a failed github issue result reporting the string form of "GitHub issue number is invalid"
                set number to number_value as an integer
                set state to the text of state_node
                set pinned to the boolean of pinned_node
                free parsed
                return @intrinsic(
                    "construct",
                    a github issue result,
                    true,
                    true,
                    number,
                    state,
                    pinned,
                    the string form of ""
                )
            set position to position + 1
        free parsed
        return no github issue was found

local function run issue command {string:verb} for {integer:number} in {string:repository_name} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "issue" to arguments
        append verb to arguments
        append the string form of number to arguments
        append the string form of "-R" to arguments
        append repository_name to arguments
        set completed to run github using tools with arguments
        free arguments
        return github result from completed

local function the issue number in {string:url}:
    execute:
        set end to the length of url
        loop while end > 0 and ((the character at end - 1 in url as a 32 bit integer) = 10 or (the character at end - 1 in url as a 32 bit integer) = 13):
            set end to end - 1
        set beginning to end
        loop while beginning > 0 and (the character at beginning - 1 in url as a 32 bit integer) != 47:
            set beginning to beginning - 1
        if beginning = 0 or beginning = end:
            return 0
        set parsed_number to 0
        set position to beginning
        loop while position < end:
            set character to the character at position in url as a 32 bit integer
            if character < 48 or character > 57:
                return 0
            set digit to character - 48
            if parsed_number > 214748364 or (parsed_number = 214748364 and digit > 7):
                return 0
            set parsed_number to parsed_number * 10 + digit
            set position to position + 1
        return parsed_number

function ensure pinned issue titled {string:title} in {string:repository_name} with body {string:body} using {a pointer to github tools:tools}:
    execute:
        set existing to find issue titled title in repository_name using tools
        if the inverse of existing's succeeded:
            return a failed github operation reporting existing's error message
        if the inverse of existing's found:
            set arguments to an empty list of string
            append the string form of "issue" to arguments
            append the string form of "create" to arguments
            append the string form of "-R" to arguments
            append repository_name to arguments
            append the string form of "--title" to arguments
            append title to arguments
            append the string form of "--body" to arguments
            append body to arguments
            set created to run github using tools with arguments
            free arguments
            if the inverse of created's succeeded:
                return a failed github operation reporting created's error message
            set created_url to created's standard output
            set number to the issue number in created_url
            if number = 0:
                return a failed github operation reporting the string form of "GitHub did not return the newly created issue URL"
            set existing to @intrinsic(
                "construct",
                a github issue result,
                true,
                true,
                number,
                the string form of "OPEN",
                false,
                the string form of ""
            )
        else:
            set arguments to an empty list of string
            append the string form of "issue" to arguments
            append the string form of "edit" to arguments
            append the string form of existing's number to arguments
            append the string form of "-R" to arguments
            append repository_name to arguments
            append the string form of "--body" to arguments
            append body to arguments
            set edited to run github using tools with arguments
            free arguments
            if the inverse of edited's succeeded:
                return a failed github operation reporting edited's error message
            if existing's state = "CLOSED":
                set reopened to run issue command "reopen" for existing's number in repository_name using tools
                if the inverse of reopened's succeeded:
                    return reopened
        if the inverse of existing's pinned:
            set pin_operation to run issue command "pin" for existing's number in repository_name using tools
            if the inverse of pin_operation's succeeded:
                return pin_operation
        return a successful github operation with the string form of ""

function close issue titled {string:title} in {string:repository_name} using {a pointer to github tools:tools}:
    execute:
        set existing to find issue titled title in repository_name using tools
        if the inverse of existing's succeeded:
            return a failed github operation reporting existing's error message
        if the inverse of existing's found:
            return a successful github operation with the string form of ""
        if existing's pinned:
            set unpinned to run issue command "unpin" for existing's number in repository_name using tools
            if the inverse of unpinned's succeeded:
                return unpinned
        if existing's state != "CLOSED":
            set arguments to an empty list of string
            append the string form of "issue" to arguments
            append the string form of "close" to arguments
            append the string form of existing's number to arguments
            append the string form of "-R" to arguments
            append repository_name to arguments
            append the string form of "--reason" to arguments
            append the string form of "completed" to arguments
            append the string form of "--comment" to arguments
            append the string form of "Resolved." to arguments
            set closed to run github using tools with arguments
            free arguments
            return github result from closed
        return a successful github operation with the string form of ""

