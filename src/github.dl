local function a failed github operation reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a github operation result,
            false,
            the string form of "",
            message
        )

local function github result from {tool result:completed}:
    execute:
        if completed's succeeded:
            return a successful github operation with completed's standard output
        return a failed github operation reporting completed's error message

local function run github using {a pointer to github tools:tools} with {a pointer to list:arguments}:
