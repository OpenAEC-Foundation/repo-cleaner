local function a new JSON text containing {string:value}:
    execute:
        set node to a new JSON value of kind the JSON text kind
        set the text of node to value
        return node

function read github file {string:path} in {string:repository_name} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "api" to arguments
        append (the string form of "repos/") + repository_name + the string form of "/contents/" + path to arguments
        append the string form of "--jq" to arguments
        append the string form of "{content:.content,sha:.sha}" to arguments
        set completed to run github using tools with arguments
        free arguments
        if the inverse of completed's succeeded:
            if completed's standard error contains "(HTTP 404)":
                return a missing github file result
            return a failed github file result reporting completed's error message

        parse completed's standard output as JSON and set parsed to it
        if parsed failed:
            free parsed
            return a failed github file result reporting the string form of "GitHub file data is not valid JSON"
        set root to the value of parsed
        set incomplete to root is not a JSON object
        if the inverse of incomplete:
            set incomplete to root lacks JSON member named "content"
            if the inverse of incomplete:
                set incomplete to root lacks JSON member named "sha"
        if incomplete:
            free parsed
            return a failed github file result reporting the string form of "GitHub file data is incomplete"
        set content_node to the JSON member named "content" in root
        set sha_node to the JSON member named "sha" in root
        if the kind of content_node != the JSON text kind or the kind of sha_node != the JSON text kind:
            free parsed
            return a failed github file result reporting the string form of "GitHub file data is invalid"
        set decoded to decode the base64 text the text of content_node
        if the inverse of decoded's succeeded:
            set message to decoded's error message
            free parsed
            return a failed github file result reporting message
        set contents to decoded's value
        set sha to the text of sha_node
        free parsed
        return @intrinsic(
            "construct",
            a github file result,
            true,
            true,
            contents,
            sha,
            the string form of ""
        )

function write github file {string:path} in {string:repository_name} with contents {string:contents}, message {string:message}, branch {string:branch}, and existing sha {string:sha} using {a pointer to github tools:tools}:
    execute:
        set payload to a new JSON value of kind the JSON object kind
        add a JSON member named "message" with value a new JSON text containing message to payload
        add a JSON member named "content" with value a new JSON text containing the base64 encoding of contents to payload
        add a JSON member named "branch" with value a new JSON text containing branch to payload
        if the length of sha > 0:
            add a JSON member named "sha" with value a new JSON text containing sha to payload
        set body to the compact JSON form of payload
        free payload

        set arguments to an empty list of string
        append the string form of "api" to arguments
        append (the string form of "repos/") + repository_name + the string form of "/contents/" + path to arguments
        append the string form of "--method" to arguments
        append the string form of "PUT" to arguments
        append the string form of "--input" to arguments
        append the string form of "-" to arguments
        append the string form of "--silent" to arguments
        set completed to run github using tools with arguments and input body
        free arguments
        return github result from completed

function list repositories in {string:organization} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "repo" to arguments
        append the string form of "list" to arguments
        append organization to arguments
        append the string form of "--limit" to arguments
        append the string form of "1000" to arguments
        append the string form of "--json" to arguments
        append the string form of "name,defaultBranchRef" to arguments
        set completed to run github using tools with arguments
        free arguments
        if the inverse of completed's succeeded:
            return @intrinsic(
                "construct",
                a github repository list result,
                false,
                an empty list of github repository,
                completed's error message
            )

        parse completed's standard output as JSON and set parsed to it
        if parsed failed:
            free parsed
            return @intrinsic(
                "construct",
                a github repository list result,
                false,
                an empty list of github repository,
                the string form of "GitHub repository list is not valid JSON"
            )
        set root to the value of parsed
        if root is not a JSON array:
            free parsed
            return @intrinsic(
                "construct",
                a github repository list result,
                false,
                an empty list of github repository,
                the string form of "GitHub repository list must be an array"
            )

        set repository_values to an empty list of github repository
        set position to 0
        loop while position < the number of JSON items in root:
            set decoded to github repository from the JSON value at index position in root
            if the inverse of decoded's succeeded:
                set message to decoded's error message
                free github repository result decoded
                free repository_values
                free parsed
                return @intrinsic(
                    "construct",
                    a github repository list result,
                    false,
                    an empty list of github repository,
                    message
                )
            set decoded_repository to decoded's repository
            set repository_value to @intrinsic(
                "construct",
                a github repository,
                decoded_repository's name,
                decoded_repository's default branch,
                decoded_repository's empty
            )
            append repository_value to repository_values
            free github repository result decoded
            set position to position + 1
        free parsed
        return @intrinsic(
            "construct",
            a github repository list result,
            true,
            repository_values,
            the string form of ""
        )

function inspect repository {string:repository_name} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "repo" to arguments
        append the string form of "view" to arguments
        append repository_name to arguments
        append the string form of "--json" to arguments
        append the string form of "name,defaultBranchRef" to arguments
        set completed to run github using tools with arguments
        free arguments
        if the inverse of completed's succeeded:
            return a failed github repository result reporting completed's error message
        parse completed's standard output as JSON and set parsed to it
        if parsed failed:
            free parsed
            return a failed github repository result reporting the string form of "GitHub repository data is not valid JSON"
        set decoded to github repository from the value of parsed
        free parsed
        return decoded

function rename github repository {string:repository_name} to {string:new_name} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "api" to arguments
        append (the string form of "repos/") + repository_name to arguments
        append the string form of "--method" to arguments
        append the string form of "PATCH" to arguments
        append the string form of "--field" to arguments
        append (the string form of "name=") + new_name to arguments
        append the string form of "--silent" to arguments
        set completed to run github using tools with arguments
        free arguments
        return github result from completed

function prepare scanner checkout of {string:repository_name} at {string:destination} from {string:base_branch} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "repo" to arguments
        append the string form of "clone" to arguments
        append repository_name to arguments
        append destination to arguments
        set cloned to run github using tools with arguments
        free arguments
        if the inverse of cloned's succeeded:
            return a failed github operation reporting cloned's error message

        set arguments to an empty list of string
        append the string form of "checkout" to arguments
        append the string form of "-B" to arguments
        append the scanner branch name to arguments
        append (the string form of "origin/") + base_branch to arguments
        set checked_out to run git using tools with arguments in destination
        free arguments
        return github result from checked_out

