            return a failed github pull request result reporting the string form of "GitHub pull request data must be an object"
        if node lacks JSON member named "number" or node lacks JSON member named "url":
            free parsed
            return a failed github pull request result reporting the string form of "GitHub pull request data is incomplete"
        set number_node to the JSON member named "number" in node
        set url_node to the JSON member named "url" in node
        if the kind of number_node != the JSON number kind or the kind of url_node != the JSON text kind:
            free parsed
            return a failed github pull request result reporting the string form of "GitHub pull request data is invalid"
        set number_value to the number of number_node
        if number_value < 1.0 or number_value > 2147483647.0:
            free parsed
            return a failed github pull request result reporting the string form of "GitHub pull request number is invalid"
        set number to number_value as an integer
        set url to the text of url_node
        free parsed
        return @intrinsic(
            "construct",
            a github pull request result,
            true,
            true,
            number,
            url,
            the string form of ""
        )

