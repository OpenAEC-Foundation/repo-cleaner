function find scanner pull request in {string:repository_name} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "pr" to arguments
        append the string form of "list" to arguments
        append the string form of "-R" to arguments
        append repository_name to arguments
        append the string form of "--state" to arguments
        append the string form of "open" to arguments
        append the string form of "--head" to arguments
        append the scanner branch name to arguments
        append the string form of "--json" to arguments
        append the string form of "number,url" to arguments
        append the string form of "--limit" to arguments
        append the string form of "1" to arguments
        set completed to run github using tools with arguments
        free arguments
        if the inverse of completed's succeeded:
            return a failed github pull request result reporting completed's error message
        parse completed's standard output as JSON and set parsed to it
        if parsed failed:
            free parsed
            return a failed github pull request result reporting the string form of "GitHub pull request list is not valid JSON"
        set root to the value of parsed
        if root is not a JSON array:
            free parsed
            return a failed github pull request result reporting the string form of "GitHub pull request list must be an array"
        if the number of JSON items in root = 0:
            free parsed
            return @intrinsic(
                "construct",
                a github pull request result,
