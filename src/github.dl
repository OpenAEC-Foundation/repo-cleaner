function [the|] scanner branch name:
    replacement:
        the string form of "repo-cleaner/convention-fixes"

function github tools using {string:gh_executable} and {string:git_executable}:
    execute:
        set value to @intrinsic(
            "construct",
            the github tools,
            gh_executable,
            git_executable
        )
        allocate one slot of value and set allocated_tools to it
        return allocated_tools

function [the|] default github tools:
    replacement:
        github tools using "gh" and "git"

function free github tools {a pointer to github tools:tools}:
    execute:
        @intrinsic("destroy at", tools)
        @intrinsic("call", "libc", "free", nothing, tools)

local function a successful github operation with {string:output}:
    replacement:
        @intrinsic(
            "construct",
            a github operation result,
            true,
            output,
            the string form of ""
