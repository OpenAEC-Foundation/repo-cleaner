local function an allocated github repository named {string:name} with branch {string:branch} empty {boolean:empty}:
    execute:
        set value to @intrinsic(
            "construct",
            a github repository,
            name,
            branch,
            empty
        )
        allocate one slot of value and set allocated_repository to it
        return allocated_repository

local function github repository from {a pointer to a JSON value:node}:
    execute:
        if node is not a JSON object:
            return a failed github repository result reporting the string form of "GitHub repository data must be an object"
        if node lacks JSON member named "name" or node lacks JSON member named "defaultBranchRef":
            return a failed github repository result reporting the string form of "GitHub repository data is incomplete"
        set name_node to the JSON member named "name" in node
        if the kind of name_node != the JSON text kind:
            return a failed github repository result reporting the string form of "GitHub repository name must be text"
        set name to the text of name_node
        set branch_node to the JSON member named "defaultBranchRef" in node
        if branch_node is JSON null:
            set allocated_repository to an allocated github repository named name with branch the string form of "" empty true
            return @intrinsic(
                "construct",
                a github repository result,
                true,
                allocated_repository,
                the string form of ""
            )
        if branch_node is not a JSON object or branch_node lacks JSON member named "name":
            return a failed github repository result reporting the string form of "GitHub default branch data is invalid"
        set branch_name_node to the JSON member named "name" in branch_node
        if the kind of branch_name_node != the JSON text kind:
            return a failed github repository result reporting the string form of "GitHub default branch name must be text"
        set allocated_repository to an allocated github repository named name with branch the text of branch_name_node empty false
        return @intrinsic(
            "construct",
            a github repository result,
            true,
            allocated_repository,
            the string form of ""
        )

function verify github authentication using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "auth" to arguments
        append the string form of "status" to arguments
        set completed to run github using tools with arguments
        free arguments
        return github result from completed

function fetch {string:path} from github repository {string:repository_name} using {a pointer to github tools:tools}:
    execute:
        set arguments to an empty list of string
        append the string form of "api" to arguments
        append (the string form of "repos/") + repository_name + the string form of "/contents/" + path to arguments
        append the string form of "--header" to arguments
        append the string form of "Accept: application/vnd.github.raw+json" to arguments
        set completed to run github using tools with arguments
        free arguments
        return github result from completed

